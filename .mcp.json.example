{
  "mcpServers": {
    "mempalace": {
      "type": "stdio",
      "command": "python3.11",
      "args": ["<synaptic-memory-path>/scripts/mempalace_mcp_fast.py", "--palace", "<storage-path>/palace"],
      "env": {
        "MEMPALACE_HARNESS": "claude-code"
      }
    },
    "graphify": {
      "type": "stdio",
      "command": "python3.14",
      "args": ["-m", "graphify.serve", "graphify-out/graph.json"],
      "env": {
        "SYNAPTIC_SCAN_ROOT": "<your-projects-root>"
      }
    }
  }
}
